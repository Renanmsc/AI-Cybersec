{
  "manifest_version": 2,
  "name": "Privacy Tracker Detector",
  "version": "0.1.0",
  "description": "Extensão para análise de rastreadores e privacidade em páginas web.",
  "permissions": [
    "tabs",
    "webRequest",
    "cookies",
    "storage",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_title": "Privacy Tracker Detector",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}