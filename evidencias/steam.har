leList_SubTitle\":\"All Bundles that Contain:\",\"BundleList_SortBy\":\"Sort By:\",\"BundleList_SortBy_Popular\":\"Popular\",\"BundleList_SortBy_Price\":\"Price\",\"BundleList_SortBy_Discount\":\"Bundle Discount\",\"BundleList_SortBy_Name\":\"Name\",\"BundleList_AllInLibrary\":\"Your complete bundles\",\"BundleList_AllInLibrarySubtitle\":\"All contents of these bundles are in your library\",\"BundleList_CompleteTheSet\":\"Complete the Set Bundles\",\"BundleList_CompleteTheSetSubtitle\":\"Purchase the remaining titles not yet in your library to complete the bundle\",\"BundleList_MustPurchaseAsSet\":\"Must Purchase Together Bundles\",\"BundleList_MustPurchaseAsSetSubtitle\":\"Includes all items together as one bundle; must be purchased as a complete set\",\"FamilyGames_SharedLibrary\":\"Shared Library\",\"FamilyGames_IncludedGames\":\"Included Games\",\"FamilyGames_ExcludedGames\":\"Excluded Games\",\"FamilyGames_FreeGames\":\"Free Games\",\"FamilyGames_Count\":\"%1$s Titles\",\"FamilyGames_ShowMore\":\"Show More\",\"FamilyGames_ShowAll\":\"Show All\",\"FamilyGames_EmptySearch\":\"No games meet your search criteria.\",\"FamilyGames_NoGames\":\"There are no games in your family library.\",\"FamilyGames_Error\":\"An error occurred while loading your family library. Please try again later. (%1$s)\",\"EventEditor_Preview_CrossPromo_setup\":\"Preview Mode: Sale Page Cross Promo not setup\",\"EventEditor_Preview_CrossPromo_missing\":\"Preview Mode: Sale Page Cross Promo sale page is not visible or cannot be loaded.\",\"FamilyGames_Sort_Alphabetical\":\"A-Z\",\"FamilyGames_Sort_DateAcquired\":\"Date Acquired\",\"FamilyGame_DateAcquired\":\"Added to library: %1$s\",\"FamilyGame_Excluded_License\":\"This game is not available for Family Sharing\",\"FamilyGame_Excluded_FreeApp\":\"Free games cannot be shared\",\"FamilyGame_Excluded_Private\":\"You have marked this game as Private\",\"FamilyGame_Excluded_OptedOut\":\"The publisher has opted this game out of Family Sharing\",\"FamilyGame_Excluded_Nonrefundable_DLC\":\"This DLC is not available for Family Sharing\",\"FamilyGame_Excluded_ParentAppExcluded\":\"This DLC is not available for Family Sharing\",\"FamilyGame_Excluded_UnreleasedApp\":\"This game hasn\\'t been released\",\"FamilyGame_Excluded_WrongAppType\":\"This type of content cannot be shared\",\"FamilyGame_Excluded_DevPackage\":\"Developer granted games cannot be shared\",\"FamilyGame_Excluded_FreeWeekend\":\"Free weekend games cannot be shared\",\"FamilyGame_Excluded_InvalidPackage\":\"This game is not available for Family Sharing\",\"FamilyGame_Excluded_Subscription\":\"Games purchased with a subscription cannot be shared\",\"FamilyGame_Excluded_SpecialPackage\":\"This game cannot be shared\",\"FamilyGame_Excluded_NoShareableApps\":\"This game cannot be shared\",\"FamilyGame_Excluded_WrongLicenseType\":\"This type of content cannot be shared\",\"FamilyGame_Excluded_Borrowed\":\"This game is shared from another owner\",\"FamilyGame_Excluded_LicensePending\":\"This game\\'s license is pending\",\"FamilyGame_Excluded_RefundPending\":\"This game has a pending refund\",\"FamilyGame_Excluded_TimedTrial\":\"Timed trial games cannot be shared\",\"FamilyGame_Excluded_LicenseInactive\":\"This game\\'s license is inactive\",\"FamilyGame_Excluded_Unknown\":\"This game is not available for Family Sharing\",\"FamilyGame_Excluded_PrivateLicense\":\"This game is in a package with a game you marked as Private\",\"FamilyGame_ExcludedCode\":\"Code %1$s\",\"FamilyGame_PlayGame\":\"Play Game\",\"FamilyGame_OpenAppDetails\":\"View in Library\",\"FamilyGame_ViewStore\":\"Go to Store Page\",\"FamilyGame_MarkAsPrivate\":\"Mark as Private\",\"FamilyGame_UnmarkAsPrivate\":\"Unmark as Private\",\"FamilyGame_AllowForChild\":\"Allow for %1$s\",\"FamilyGame_DenyForChild\":\"Block for %1$s\",\"FamilyPlaytime_NoChildren\":\"You have no child accounts in your family.\",\"FamilyPlaytime_ShowPlaytimeFor\":\"Show playtime for:\",\"FamilyPlaytime_NoPlaytime\":\"No playtime\",\"FamilyPlaytime_1Minute\":\"1 minute\",\"FamilyPlaytime_Minutes\":\"%1$s minutes\",\"FamilyPlaytime_1Hour\":\"1 hour\",\"FamilyPlaytime_Hours\":\"%1$s hours\",\"FamilyPlaytime_4AM\":\"4AM\",\"FamilyPlaytime_8AM\":\"8AM\",\"FamilyPlaytime_Noon\":\"Noon\",\"FamilyPlaytime_4PM\":\"4PM\",\"FamilyPlaytime_8PM\":\"8PM\",\"FamilyPlaytime_PreviousDay\":\"Previous day\",\"FamilyPlaytime_NextDay\":\"Next day\",\"FamilyPlaytime_GamesPlayedBetween\":\"Games played between %1$s and %2$s:\",\"Steamawards_Title\":\"The%1$sSteam%2$sAwards\",\"Steamawards_Title_WithYear\":\"The %1$s%2$sSteam%2$sAwards\",\"Steamawards_Title_WithYear_NoBreaks\":\"The %1$s Steam Awards\",\"Steamawards_TheSteamAwards\":\"THE STEAM AWARDS\",\"Steamawards_NominateNow\":\"NOMINATE YOUR CHOICES - NOW UNTIL DEC 1st @ 10AM Pacific.\",\"Steamawards_LevelUpNow\":\"LEVEL UP YOUR %1$s NOMINATION COMMITTEE BADGE.\",\"Steamawards_VoteWinter\":\"VOTE FROM THE FINALISTS DURING THE WINTER SALE.\",\"Steamawards_WinnersAnnounced\":\"WINNERS ANNOUNCED JAN 3RD @ 10AM Pacific.\",\"Steamawards_Nominate_Btn\":\"Choose Your Nominee\",\"Steamawards_Edit_Btn\":\"Edit Your Nominee\",\"Steamawards_Login_Btn\":\"Login To Choose A Nominee\",\"Steamawards_Nominate\":\"Nominate\",\"Steamawards_Skip_Btn\":\"Skip this category\",\"Steamawards_MakeYourOwnNominations_Btn\":\"Click here to enter your own nominations\",\"Steamawards_Nominated\":\"Nominated\",\"Steamawards_ShowFinalists_Btn\":\"Show Finalists\",\"Steamawards_HideFinalists_Btn\":\"Hide Finalists\",\"Steamawards_Task1\":\"Nominate a game in at least one category\",\"Steamawards_Task2\":\"Nominate a game in each category\",\"Steamawards_Task3\":\"Review (or update your review) for a game you\\'ve nominated\",\"Steamawards_Task4\":\"Play a game you\\'ve nominated\",\"Steamawards_FAQ_Title_Badges\":\"Badge FAQs\",\"Steamawards_FAQ_Title_Nominations\":\"Nomination FAQs\",\"Steamawards_FAQ_XP_Q\":\"Does the badge earn me XP?\",\"Steamawards_FAQ_XP_A\":\"Yes, each level of the badge gives an additional 25XP.\",\"Steamawards_FAQ_BadgesAll_Q\":\"Where can I see all my badges?\",\"Steamawards_FAQ_BadgesAll_A_wLink\":\"You can see all your completed and in progress badges from %1$s.\",\"Steamawards_FAQ_BadgesAll_A_YourBadges\":\"your badges page\",\"Steamawards_FAQ_ReviewsPrev_Q\":\"Do previous reviews count?\",\"Steamawards_FAQ_ReviewsPrev_A\":\"You’ll need to post a new review (for a game you’ve nominated) or update a review you previously posted. Make sure to nominate the game first. Use the review to tell other players why you think that game should win.\",\"Steamawards_FAQ_BadgeSkipping_Q\":\"Does skipping a category count towards the badge?\",\"Steamawards_FAQ_BadgeSkipping_A1\":\"You can skip any category where you don\\'t feel that you have enough data to confidently nominate any game. As long as you specifically click the button to skip a category, it will count toward your badge.\",\"Steamawards_FAQ_BadgeSkipping_A2\":\"To skip a category, scroll up this page to the desired category and click “Select Nominee”. You will see some nomination options as well as a “Skip” button near the bottom.\",\"Steamawards_FAQ_WhoCanNominate_Q\":\"Who can nominate a game for the Steam Awards?\",\"Steamawards_FAQ_WhoCanNominate_A\":\"To prevent nomination abuse and botting, any non-limited Steam account can nominate and vote in the Steam Awards.\",\"Steamawards_FAQ_HowToNominate_Q\":\"How do I set my nominations?\",\"Steamawards_FAQ_HowToNominate_A\":\"You can nominate games by scrolling up this page to the desired category and clicking “Select Nominee”. You will see a few suggestions for games you\\'ve played, recommended games, or the option to simply search for a game.\",\"Steamawards_FAQ_WhichGames_Q\":\"Which games can I nominate?\",\"Steamawards_FAQ_WhichGames_A1\":\"The eligibility for the Labor of Love category works a little different from all the other categories.\",\"Steamawards_FAQ_WhichGames_A2\":\"The Labor of Love category is intended for games that have been around long enough to have been shown lots of development love - at least a year or so. So all games that released prior to last year\\'s autumn sale are eligible for nomination with the exception of previous year\\'s winners (Warframe, GTA V, CS2, Terraria, Cyberpunk 2077, Red Dead Redemption 2 and Elden Ring).\",\"Steamawards_FAQ_WhichGames_A3\":\"For every category except Labor of Love, only games that released on Steam after the previous year\\'s Autumn Sale will be eligible for nominations.\",\"Steamawards_FAQ_NominateMultiple_Q\":\"Can I nominate the same game for multiple categories?\",\"Steamawards_FAQ_NominateMultiple_A\":\"Yes, you can nominate a single game for as many categories as you think are appropriate.\",\"Steamawards_FAQ_EditNominations_Q\":\"Can I edit my nominations?\",\"Steamawards_FAQ_EditNominations_A\":\"Yes, click the “Edit” button above your current choice to change your nomination.\",\"Steamawards_FAQ_HowShareFriends_Q\":\"How do I share my nominees with my friends?\",\"Steamawards_FAQ_HowShareFriends_A\":\"To share your nominees, click on the “Generate new link” button right below the Steam Award categories on this page. You\\'ll be able to create a link to share your nominations page with your friends even if you haven\\'t finished nominating for all categories. Generating a new link will invalidate any prior links.\",\"Steamawards_FAQ_WinnersSelected_Q\":\"When are the winners selected and announced?\",\"Steamawards_FAQ_WinnersSelected_A\":\"The five finalists in each category will be available to vote on during the Steam Winter Sale this December. Voting will be open until January 3rd @ 10AM PST, at which point we\\'ll immediately announce the winners.\",\"Steamawards_FAQ_WhyParticipate_Q\":\"Why should I participate?\",\"Steamawards_FAQ_WhyParticipate_A\":\"Because your opinion matters!\",\"Steamawards_Badge_SectionTitle\":\"COMPLETE THESE TASKS\",\"Steamawards_Badge_BadgeTitle\":\"Steam Awards Nomination Committee Badge\",\"Steamawards_Badge_BadgeDesc\":\"Nominate a game in at least one category to earn level one of the badge. Then, complete additional tasks to level it up.\",\"Steamawards_Badge_BadgeTask1\":\"1 task completed\",\"Steamawards_Badge_BadgeTask2\":\"2 tasks completed\",\"Steamawards_Badge_BadgeTask3\":\"3 tasks completed\",\"Steamawards_Badge_BadgeTask4\":\"4 tasks completed\",\"Steamawards_Nominate_ThisYear\":\"Select a game that released this year\",\"Steamawards_Nominate_PastYear\":\"Select a game that released more than a year ago\",\"Steamawards_Nominate_Search\":\"Search for a specific eligible game...\",\"Steamawards_Nominate_GamesYouPlayed\":\"Games You\\'ve Played\",\"Steamawards_Nominate_Recommended\":\"Popular & Recommended Games\",\"Steamawards_Nominate_Events\":\"Developers make their case\",\"Steamawards_Nominate_NoEligibleGames\":\"You haven’t played any eligible games this year\",\"Steamawards_Nominate_NoEligibleGames_cont\":\"But that\\'s okay; you can skip this category or check out suggested games below.\",\"Steamawards_Nominate_CheckSuggested\":\"Or, check out suggested games below\",\"Steamawards_ShareLink_Placeholder\":\"Click button below to generate unique link to share\",\"Steamawards_ShareLink_Title\":\"Share your nominations\",\"Steamawards_ShareLink_Btn\":\"Share your nominations...\",\"Steamawards_GenerateLink_Btn\":\"Generate Share Link\",\"Steamawards_Nominate_Error_NoMatch\":\"The game (%1$s) isn\\'t eligible for this category. If you think this is incorrect please contact Steam Support.\",\"Steamawards_Nominate_Error_Generic\":\"We encountered an error while nominating this game (%1$s). Please try again later. (%2$s)\",\"Steamawards_GenerateLink_Fallback\":\"Get started below.\",\"Steamawards_Close_Btn\":\"Close\",\"Steamawards_GenerateLink_Btn_Renew\":\"Invalidate Link & Generate New One\",\"Steamawards_ShareModal_Description\":\"Click below to generate a unique, sharable link. Only users that are signed in to Steam and have this link can see your nominations.\",\"Steamawards_ShareModal_Description2\":\"If you wish to invalidate a link and create a new one, simply click to re-generate. Note that anyone with the previous URL will no longer be able to access your nominations.\",\"Steamawards_TotalNominations\":\"You\\'ve nominated games in %1$s of %2$s categories!\",\"Steamawards_Search_NoResults\":\"No eligible games match your search term\",\"Steamawards_FriendsNominations\":\"%1$s\\'s Nominations\",\"Steamawards_Playtime_Hours\":\"%1$s hrs played\",\"Steamawards_Voting_Header_VoteNow\":\"VOTE NOW!\",\"Steamawards_Voting_Header_WinnersUp\":\"PRESENTING YOUR WINNERS!\",\"Steamawards_Voting_Header_VoteSoon\":\"VOTING STARTS DEC 21st @ 10am PACIFIC!\",\"Steamawards_Voting_Header_VoteSoon_New\":\"VOTING STARTS %1$s!\",\"Steamawards_Voting_Header_Winners\":\"The community has spoken! Your votes throughout the Steam Winter Sale have chosen these games below as winners of the %1$s Steam Awards!\",\"Steamawards_Voting_Header_Finalists\":\"You\\'ve chosen the nominees - now we need your help in choosing the winners!\",\"Steamawards_Voting_Header_HowTo\":\"Cast your vote until %1$s.\",\"Steamawards_Voting_Header_Dates\":\"Winners announced here when voting ends.\",\"Steamawards_Voting_Header_Dates_New\":\"Winners announced here when voting ends.\",\"Steamawards_Voting_Categories\":\"Categories\",\"Steamawards_Voting_Scroll\":\"Scroll Down<1></1> To Vote\",\"Steamawards_Voting_Action_Vote\":\"Vote\",\"Steamawards_Voting_Action_Voted\":\"Vote Submitted\",\"Steamawards_Voting_Action_YourNominee\":\"Your Nomination\",\"Steamawards_Voting_YourVote\":\"Your Vote\",\"Steamawards_Voting_Winner\":\"Winner\",\"Steamawards_Progress_Title_Past\":\"You\\'ve unlocked these chat stickers by voting in %1$s of %2$s categories during the Winter Sale.\",\"Steamawards_Progress_Title\":\"You\\'ve unlocked these chat stickers by voting in %1$s of %2$s categories.\",\"Steamawards_Progress_Title_Soon\":\"Unlock special chat stickers for each of the %1$s categories you vote in.\",\"Steamawards_Progress_Title_None\":\"Unlock special stickers by voting on each of the %1$s categories below.\",\"Steamawards_Progress_Title_LoggedOut\":\"Sign in and earn a sticker for voting in each category.\",\"Steamawards_Voting_Finalists\":\"Cast your vote for one of these finalists during the Winter Sale:\",\"Steamawards_Voting_Finalists_Past\":\"The finalists:\",\"Steamawards_Voting_FAQ_Title\":\"Frequently Asked Questions\",\"Steamawards_Voting_FAQ_1_Q\":\"Who is eligible to vote?\",\"Steamawards_Voting_FAQ_1_A\":\"Any <1>non-limited Steam account</1> can vote in the Steam Awards.\",\"Steamawards_Voting_FAQ_2_Q\":\"Do I get anything for voting?\",\"Steamawards_Voting_FAQ_2_A\":\"Yes, in addition to the warm fuzzy feeling you get from helping shine a light on some of the amazing games of the year, each category you vote on will also grant you a special Steam Awards sticker.\",\"Steamawards_Voting_FAQ_3_Q\":\"How long do I have to vote for each category?\",\"Steamawards_Voting_FAQ_3_A\":\"Voting is open for all categories starting December 21st @ 10am Pacific, and will be available until January 2nd @ 10am Pacific.\",\"Steamawards_Voting_FAQ_3_A_New\":\"Voting is open for all categories starting %1$s, and will be available until %2$s.\",\"Steamawards_Voting_FAQ_4_Q\":\"When will the winners be announced?\",\"Steamawards_Voting_FAQ_4_A\":\"All winners will be announced here on January 2nd at 10am Pacific.\",\"Steamawards_Voting_FAQ_4_A_New\":\"All winners will be announced here on %1$s.\",\"Steamawards_Voting_FAQ_5_Q\":\"What do the winning games get?\",\"Steamawards_Voting_FAQ_5_A\":\"A beautiful physical Steam Awards trophy shipped to the developers\\' offices and a virtual trophy on the game\\'s store page. Not only that, but we all shall forever remember the game as winner of The Steam Awards!\",\"Steamawards_Voting_FAQ_6_Q\":\"How were the finalists chosen?\",\"Steamawards_Voting_FAQ_6_A\":\"The finalists were chosen by your nominations! Games can only be eligible for a maximum of two categories: Game Of The Year (or VR Game Of The Year) and one other category.\",\"Steamawards_Voting_FAQ_6_Q_2024\":\"How were the finalists chosen?\",\"Steamawards_Voting_FAQ_6_A_2024\":\"The finalists were chosen by your nominations! Games are eligible across each of the platform categories (Game Of The Year, VR Game Of The Year, and Best Game on Deck) as well as two non-platform categories.\",\"Steamawards_Voting_FAQ_7_Q\":\"How many times can I vote?\",\"Steamawards_Voting_FAQ_7_A\":\"You can cast a vote for each of the eleven categories.\",\"Steamawards_Voting_FAQ_8_Q\":\"Can I change my vote?\",\"Steamawards_Voting_FAQ_8_A\":\"Yes, you can change your vote up until voting ends.\",\"Cart_CountWidget\":\"Cart (%1$s)\",\"CreatorHome_SocialMedia_Title\":\"Social Media\",\"CreatorHome_SocialMedia_Desc\":\"Optionally provide links to your Creator Home specific social media.\",\"CreatorHome_EventLink_Title\":\"Pages\",\"CreatorHome_EventLink_Desc\":\"Choose a published Creator Home page to become your current Creator Home.\",\"CreatorHome_EventLink_BasicActive\":\"You have a Basic Creator Home active.\",\"CreatorHome_EventLink_V2Active\":\"You have a Creator Home v2 active.\",\"CreatorHome_EventLink_Unpublished\":\"Unpublished\",\"CreatorHome_EventLink_Unpublished_ttip\":\"You can only select published events. Go to the editor and publish this event from there.\",\"CreatorHome_EventLink_PublishedAndNotSelected\":\"Unlisted\",\"CreatorHome_EventLink_PublishedAndNotSelected_ttip\":\"Creator Homes that are published are visible to customers if they have the right address, even if they are not currently selected. Delete this Creator Home if you\\'re not using it anymore.\",\"CreatorHome_EventLink_Create\":\"Create New\",\"CreatorHome_EventLink_Create_ttip\":\"Create a new Creator Home event.\",\"CreatorHome_EventLink_ActiveListTitle\":\"Active\",\"CreatorHome_EventLink_